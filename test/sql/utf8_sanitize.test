# Sanitization runs before dedup, not after: distinct ill-formed keys can repair to the same
# string, and it is the repaired string that lands in the result — so two such keys are one key.
# Deduping on the raw bytes would emit a duplicate key, which is undefined for a MAP consumer.
query IIII
SELECT query_params_from_string('%FF=1&%FE=2', query_values := 'last'),
       cardinality(query_params_from_string('%FF=1&%FE=2')),
       query_params_from_string('a%FF=1&a%FE=2&a%FD=3', query_values := 'last'),
       query_params_from_string('a%FF=1&a%FE=2&a%FD=3');
----
{�=2}	1	{a�=3}	{a�=[1, 2, 3]}

# One sanitizer stands behind every function, so an ill-formed sequence lands identically wherever
# it is read: as a struct field, as a standalone map, as a scalar. The map values are VARCHAR,
# which DuckDB requires to be well-formed UTF-8.
query IIIII
SELECT hex(CAST((url_components('https://example.com/?a=%ED%A0%80', 'last')).query_params AS JSON)::VARCHAR),
       hex(CAST((url_components('https://example.com/?a=%ED%A0%80', 'all')).query_params AS JSON)::VARCHAR),
       hex((url_components('https://example.com/?a=%ED%A0%80', 'last')).query_params['a']),
       hex(CAST(query_params('https://example.com/?a=%ED%A0%80', 'last') AS JSON)::VARCHAR),
       hex(query_param('https://example.com/?a=%ED%A0%80', 'a'));
----
7B2261223A22EFBFBDEFBFBDEFBFBD227D	7B2261223A5B22EFBFBDEFBFBDEFBFBD225D7D	EFBFBDEFBFBDEFBFBD	7B2261223A22EFBFBDEFBFBDEFBFBD227D	EFBFBDEFBFBDEFBFBD
