# name: test/sql/utf8_sanitize.test
# description: percent-decoded bytes that are not valid UTF-8 are replaced with U+FFFD, per byte
# group: [sql]

require url_tools

require json

# Percent-decoding a query param can yield any byte sequence, and a DuckDB VARCHAR may not carry
# ill-formed UTF-8, so the bad bytes are replaced. This file pins that replacement at the byte
# level rather than by example: it is a characterization table, and every expected value here was
# recorded from the shipped behavior. The map is read through its JSON cast — the spelling that
# makes the bytes visible — in the 'last' mode, whose object is v1's byte for byte. Both the value
# side and the key side go through the same sanitizer, so both are pinned.

# Every byte 0x80..0xFF standing alone is ill-formed and collapses to exactly one U+FFFD
# (EF BF BD). A single result row means all 128 bytes agree; a future divergence splits the group.
query IIII
SELECT hex(CAST(query_params_from_string('a=%' || printf('%02X', b), query_values := 'last') AS JSON)::VARCHAR),
       count(*), min(b), max(b)
FROM range(128, 256) t(b)
GROUP BY 1
ORDER BY 1;
----
7B2261223A22EFBFBD227D	128	128	255

# The classic failure set, with the whole malformed sequence spelled out. The replacement is
# per-byte and deliberately NOT WHATWG maximal-subpart: a rejected 3-byte sequence yields three
# U+FFFD, not one. Valid multi-byte sequences — including ones sitting next to invalid bytes —
# must survive untouched.
query III
WITH cases(id, label, encoded) AS (VALUES
    (1, 'valid 2-byte U+0080', '%C2%80'),
    (2, 'valid 2-byte U+00E9', '%C3%A9'),
    (3, 'valid 3-byte U+0800', '%E0%A0%80'),
    (4, 'valid 3-byte U+20AC', '%E2%82%AC'),
    (5, 'valid 3-byte U+FFFD', '%EF%BF%BD'),
    (6, 'valid 4-byte U+10000', '%F0%90%80%80'),
    (7, 'valid 4-byte U+10FFFF', '%F4%8F%BF%BF'),
    (8, 'truncated 2-byte lead', '%C2'),
    (9, 'truncated 2-byte, bad continuation', '%C2A'),
    (10, 'truncated 3-byte lead', '%E2'),
    (11, 'truncated 3-byte, one continuation', '%E2%82'),
    (12, 'truncated 3-byte, bad continuation', '%E2%82A'),
    (13, 'truncated 4-byte lead', '%F0'),
    (14, 'truncated 4-byte, one continuation', '%F0%9F'),
    (15, 'truncated 4-byte, two continuations', '%F0%9F%92'),
    (16, 'truncated 4-byte, bad continuation', '%F0%9F%92A'),
    (17, 'overlong 2-byte slash', '%C0%AF'),
    (18, 'overlong 3-byte slash', '%E0%80%AF'),
    (19, 'overlong 4-byte slash', '%F0%80%80%AF'),
    (20, 'overlong 2-byte NUL', '%C0%80'),
    (21, 'overlong 3-byte NUL', '%E0%80%80'),
    (22, 'overlong 4-byte NUL', '%F0%80%80%80'),
    (23, 'overlong C1', '%C1%BF'),
    (24, 'surrogate U+D800', '%ED%A0%80'),
    (25, 'surrogate U+DFFF', '%ED%BF%BF'),
    (26, 'CESU-8 surrogate pair', '%ED%A0%BD%ED%B2%A9'),
    (27, 'past U+10FFFF, F4 90', '%F4%90%80%80'),
    (28, 'past U+10FFFF, F5', '%F5%80%80%80'),
    (29, 'past U+10FFFF, F7', '%F7%BF%BF%BF'),
    (30, 'five-byte form F8', '%F8%88%80%80%80'),
    (31, 'six-byte form FC', '%FC%84%80%80%80%80'),
    (32, 'lone FE', '%FE'),
    (33, 'lone FF', '%FF'),
    (34, 'FE FF', '%FE%FF'),
    (35, 'valid then invalid', '%C3%A9%FF'),
    (36, 'invalid then valid', '%FF%C3%A9'),
    (37, 'valid, invalid, valid', 'a%C3%A9%FFb%E2%82%ACc'),
    (38, 'continuation then valid', '%80%E2%82%AC'),
    (39, 'lead byte then valid', '%E2%C3%A9'),
    (40, 'valid then lone continuation', '%E2%82%AC%A0'),
    (41, 'four continuation bytes', '%80%81%82%83'),
    (42, 'ASCII only', 'plain'),
    (43, 'empty', '')
)
SELECT label,
       hex(CAST(query_params_from_string('a=' || encoded, query_values := 'last') AS JSON)::VARCHAR),
       hex(CAST(query_params_from_string(encoded || '=v', query_values := 'last') AS JSON)::VARCHAR)
FROM cases
ORDER BY id;
----
valid 2-byte U+0080	7B2261223A22C280227D	7B22C280223A2276227D
valid 2-byte U+00E9	7B2261223A22C3A9227D	7B22C3A9223A2276227D
valid 3-byte U+0800	7B2261223A22E0A080227D	7B22E0A080223A2276227D
valid 3-byte U+20AC	7B2261223A22E282AC227D	7B22E282AC223A2276227D
valid 3-byte U+FFFD	7B2261223A22EFBFBD227D	7B22EFBFBD223A2276227D
valid 4-byte U+10000	7B2261223A22F0908080227D	7B22F0908080223A2276227D
valid 4-byte U+10FFFF	7B2261223A22F48FBFBF227D	7B22F48FBFBF223A2276227D
truncated 2-byte lead	7B2261223A22EFBFBD227D	7B22EFBFBD223A2276227D
truncated 2-byte, bad continuation	7B2261223A22EFBFBD41227D	7B22EFBFBD41223A2276227D
truncated 3-byte lead	7B2261223A22EFBFBD227D	7B22EFBFBD223A2276227D
truncated 3-byte, one continuation	7B2261223A22EFBFBDEFBFBD227D	7B22EFBFBDEFBFBD223A2276227D
truncated 3-byte, bad continuation	7B2261223A22EFBFBDEFBFBD41227D	7B22EFBFBDEFBFBD41223A2276227D
truncated 4-byte lead	7B2261223A22EFBFBD227D	7B22EFBFBD223A2276227D
truncated 4-byte, one continuation	7B2261223A22EFBFBDEFBFBD227D	7B22EFBFBDEFBFBD223A2276227D
truncated 4-byte, two continuations	7B2261223A22EFBFBDEFBFBDEFBFBD227D	7B22EFBFBDEFBFBDEFBFBD223A2276227D
