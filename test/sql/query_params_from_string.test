# name: test/sql/query_params_from_string.test
# description: query_params_from_string parses a bare query string into a decoded JSON object
# group: [sql]

require url_tools

require json

# Bare query string, no URL around it (tracking params, url_tags, referrer fields).
query I
SELECT query_params_from_string('utm_source=yandex&utm_medium=cpc&utm_campaign=%D0%BB');
----
{"utm_source":"yandex","utm_medium":"cpc","utm_campaign":"л"}

# A leading '?' is tolerated.
query I
SELECT query_params_from_string('?a=1&b=2');
----
{"a":"1","b":"2"}

# WHATWG form semantics: '+' as space, valueless keys, '=' inside values, repeats last-wins.
query I
SELECT query_params_from_string('plus=a+b&flag&eq=a=b&dup=1&dup=2');
----
{"plus":"a b","flag":"","eq":"a=b","dup":"2"}

# Empty string yields '{}'; NULL propagates.
query II
SELECT query_params_from_string(''), query_params_from_string(NULL);
----
{}	NULL

# Custom pair separator, same decode semantics:
# '+' as space, key ends at the first '=', repeats last-wins, empty segments skipped.
query I
SELECT query_params_from_string('foo=bar|plus=a+b%20c|eq=a=b||dup=1|dup=2', '|');
----
{"foo":"bar","plus":"a b c","eq":"a=b","dup":"2"}

# A percent-encoded '&' inside a value survives a non-'&' separator.
query I
SELECT query_params_from_string('a=x%26y|b=2', '|');
----
{"a":"x&y","b":"2"}

# Separator is a substring, not a character set; explicit '&' matches the 1-arg form.
query II
SELECT query_params_from_string('a=1||b=2', '||'),
       query_params_from_string('a=1&b=2', '&') = query_params_from_string('a=1&b=2');
----
{"a":"1","b":"2"}	true

# Empty separator is a usage error.
statement error
SELECT query_params_from_string('a=1', '');
----
Invalid Input Error: query_params_from_string: separator must not be empty

# Dedup is linear, not quadratic: a many-unique-key value parses fully.
# 5000 keys k0..k4999, value "v": deterministic serialized length.
query I
SELECT length(query_params_from_string((SELECT string_agg('k' || i || '=v', '&') FROM range(5000) t(i))));
----
58891

# Last-wins and first-occurrence order still hold at scale.
query I
SELECT query_params_from_string((SELECT string_agg('k' || (i % 3) || '=' || i, '&') FROM range(3000) t(i)));
----
{"k0":"2997","k1":"2998","k2":"2999"}
